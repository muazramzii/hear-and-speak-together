# Copy this file to android/key.properties (same folder) and fill in the
# real values - key.properties itself is git-ignored (see android/.gitignore)
# and must never be committed. See docs/release-build.md for how to
# generate the keystore this points to.
storePassword=REPLACE_WITH_YOUR_KEYSTORE_PASSWORD
keyPassword=REPLACE_WITH_YOUR_KEY_PASSWORD
keyAlias=hear_speak_together
storeFile=REPLACE_WITH_ABSOLUTE_PATH_TO_YOUR_KEYSTORE/hear_speak_together.jks
