# ============================================================
#  Hear & Speak Together - Backend environment configuration
#  Copy this file to `.env` and fill in real values.
#  NEVER commit the real `.env` file.
# ============================================================

# ---- Django core ----
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2

# ---- Database (PostgreSQL) ----
# Format: postgres://USER:PASSWORD@HOST:PORT/DB_NAME
DATABASE_URL=

# ---- CORS (Flutter web / dev tooling origins) ----
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---- Azure AI Speech (Phase 3+, server-side only) ----
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# ---- Optional LLM feedback provider (Phase 5+) ----
# AI_PROVIDER: gemini | openai | mock
AI_PROVIDER=mock
# Blank uses the provider default (gemini-2.0-flash / gpt-4o-mini).
AI_MODEL=
AI_API_KEY=

# ---- Feature flags / cost control ----
ENABLE_AI_FEEDBACK=False
STORE_AUDIO=False

# ---- Speech provider ----
# "azure" uses Azure AI Speech; "mock" returns deterministic scores with no
# API call. Keep this as mock for development and testing.
SPEECH_PROVIDER=mock
