# ============================================================
#  Hear & Speak Together - Backend environment configuration
#  Copy this file to `.env` and fill in real values.
#  NEVER commit the real `.env` file.
# ============================================================

# ---- Django core ----
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2

# ---- Database (PostgreSQL) ----
# Format: postgres://USER:PASSWORD@HOST:PORT/DB_NAME
DATABASE_URL=

# ---- CORS (Flutter web / dev tooling origins) ----
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---- Optional LLM feedback provider (Phase 5+) ----
# AI_PROVIDER: gemini | openai | mock
AI_PROVIDER=mock
# Blank uses the provider default (gemini-2.0-flash / gpt-4o-mini).
AI_MODEL=
AI_API_KEY=

# ---- Feature flags / cost control ----
ENABLE_AI_FEEDBACK=False
STORE_AUDIO=False

# ---- Speech recognition (self-hosted Whisper, apps/practice/services/recognition) ----
# "whisper" transcribes locally with faster-whisper; "mock" returns a fixed
# transcript with no model load. Keep this as mock for development and
# testing - there is no paid API anywhere in this pipeline.
SPEECH_PROVIDER=mock
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# ---- Pronunciation scoring weights (must sum to 1.0) ----
PRONUNCIATION_WEIGHT_SIMILARITY=0.5
PRONUNCIATION_WEIGHT_CONFIDENCE=0.3
PRONUNCIATION_WEIGHT_COMPLETENESS=0.2
